APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Public HTTPS origin of this service. The Telegram button opens PUBLIC_BASE_URL/mini-app/.
PUBLIC_BASE_URL=
DATABASE_URL=postgresql+asyncpg://ksu:ksu@postgres:5432/ksu
REDIS_URL=redis://redis:6379/0
BOT_TOKEN=
# Bot username without @; used to build https://t.me/<bot>?start=ref_<telegram_id> partner links.
BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me

# Versioned product onboarding. Bump ONBOARDING_VERSION to require the intro again.
# Copy and external links are deployment-owned; code does not hardcode legal acceptance language.
ONBOARDING_ENABLED=true
ONBOARDING_VERSION=1
ONBOARDING_TITLE=Добро пожаловать в Ксю
ONBOARDING_BODY=Перед началом работы завершите короткий вводный экран.
# Optional HTTPS links. Non-HTTPS values are not exposed by the onboarding API.
ONBOARDING_RULES_URL=
ONBOARDING_PRIVACY_URL=

START_BALANCE_ROX=0
INTERNAL_CREDIT_RUB=10
REFERRAL_FIRST_PERCENT=30
REFERRAL_SECOND_PERCENT=5
# Product spec requires a minimum withdrawal but does not prescribe its business value.
# 0 disables a separate minimum beyond amount > 0.
PARTNER_MIN_WITHDRAWAL_RUB=0
# Package may specify credits (preferred) or legacy rox. RUB amount is derived at 10 RUB/credit.
# If both amount and credits are supplied, the backend rejects mismatches.
# Example: {"starter":{"credits":"30","currency":"RUB"}}
ROX_PACKAGES_JSON={}

# Durable generation outbox / recovery. PostgreSQL is authoritative; Redis is wake-up only.
GENERATION_WORKER_POLL_SECONDS=5
GENERATION_OUTBOX_LEASE_SECONDS=90
GENERATION_SUBMISSION_MAX_ATTEMPTS=5
GENERATION_SUBMISSION_UNKNOWN_TIMEOUT_SECONDS=900
GENERATION_RECONCILE_INTERVAL_SECONDS=60
GENERATION_RECONCILE_STALE_SECONDS=60
GENERATION_RECOVERY_BATCH_SIZE=50

# Durable product-owned media ingest. Provider result URLs are temporary sources only.
MEDIA_WORKER_POLL_SECONDS=5
MEDIA_INGEST_LEASE_SECONDS=600
MEDIA_INGEST_MAX_ATTEMPTS=5
MEDIA_INGEST_MAX_BYTES=1073741824
MEDIA_INGEST_CONNECT_TIMEOUT_SECONDS=10
MEDIA_INGEST_READ_TIMEOUT_SECONDS=180
MEDIA_INGEST_MAX_REDIRECTS=5
MEDIA_PRESIGN_TTL_SECONDS=900
MEDIA_LEGACY_RECONCILE_SECONDS=60

# Private S3-compatible bucket. Leave S3_ENDPOINT_URL empty for AWS S3.
# IAM/workload credentials may be used instead of static access keys on AWS.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=auto
S3_MULTIPART_THRESHOLD_BYTES=8388608
S3_MULTIPART_CHUNK_BYTES=8388608
S3_MAX_CONCURRENCY=4

# Payment reconciliation. The worker recovers unknown/pending provider state without creating new intents.
PAYMENT_RECONCILE_INTERVAL_SECONDS=60
PAYMENT_RECONCILE_STALE_SECONDS=30
PAYMENT_RECONCILE_BATCH_SIZE=100

# OWASP API4 / resource-consumption controls. Zero disables an optional quota.
# Expensive mutations fail closed when the limiter store is unavailable by default.
ABUSE_PROTECTION_ENABLED=true
ABUSE_FAIL_CLOSED=true
GENERATION_RATE_LIMIT_PER_MINUTE=10
GENERATION_MAX_ACTIVE_PER_USER=3
# 0 means no separate daily generation-credit quota; wallet balance still applies.
GENERATION_DAILY_SPEND_LIMIT_CREDITS=0
UPLOAD_RATE_LIMIT_PER_MINUTE=12
UPLOAD_DAILY_BYTES_LIMIT=1073741824
PAYMENT_CREATE_RATE_LIMIT_PER_MINUTE=6
KIE_SUBMIT_RATE_LIMIT_PER_MINUTE=60
KIE_CIRCUIT_FAILURE_THRESHOLD=5
KIE_CIRCUIT_FAILURE_WINDOW_SECONDS=60
KIE_CIRCUIT_OPEN_SECONDS=60

# Observability. Protect /metrics with a dedicated bearer token in production.
LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
WORKER_HEARTBEAT_TTL_SECONDS=180
WORKER_STALE_AFTER_SECONDS=120
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ksu
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.10

# Admin security contour.
# Generate a dedicated random secret, at least 32 characters. Never reuse BOT_TOKEN or provider keys.
ADMIN_SECURITY_KEY=
# Comma-separated Telegram IDs allowed to bootstrap an owner account.
# Remove bootstrap IDs after the first owner has enrolled MFA.
ADMIN_BOOTSTRAP_TELEGRAM_IDS=
ADMIN_REQUIRE_MFA=true
ADMIN_SESSION_TTL_MINUTES=480
ADMIN_IDLE_TIMEOUT_MINUTES=30
ADMIN_STEP_UP_MINUTES=10
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
ADMIN_REQUEST_RATE_LIMIT_PER_MINUTE=120
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15

KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_UPLOAD_MAX_BYTES=104857600
KIE_WEBHOOK_HMAC_KEY=
# Internal-credit prices. Video values are credits per second; images use flat credits.
# 1 internal credit = 10 RUB. Example: 8.5 credits/sec = 85 RUB/sec.
# Example: {"wan-2.7-t2v":{"per_second":"8.5"},"gpt-image-2-t2i":{"flat":"18"}}
GENERATION_PRICING_JSON={}

CRYPTOPAY_API_TOKEN=
CRYPTOPAY_BASE_URL=https://pay.crypt.bot

TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_BASE_URL=https://securepay.tinkoff.ru

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_BASE_URL=https://api.yookassa.ru

PAYMENT_RETURN_URL=
